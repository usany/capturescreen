FROM denoland/deno:2.6.7

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deno.json deno.lock ./
COPY src ./src
RUN deno cache --node-modules-dir=auto src/main.ts

RUN deno run -A npm:playwright@1.62.0 install chromium \
    && rm -rf /tmp/* || true

COPY . .
RUN deno task build

ENV PORT=3000
EXPOSE 3000

CMD ["deno", "task", "start"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD deno eval --allow-net --allow-env "const r = await fetch('http://127.0.0.1:\${PORT:-3000}/api/health'); Deno.exit(r.ok ? 0 : 1)"
